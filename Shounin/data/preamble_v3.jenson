jenson {
    story {
        name "Indexing Your Heart"
        authors "Indexing Your Heart authors"
        chapter 1 name="Mise en Abyme"
        copyright "(C) 2021-2024 Indexing Your Heart authors."
    }

    timeline {
        // NOTE: This scene is intended to be played before the game loop starts as an introduction to the game's premise and its characters.
        refresh "Apartment" kind="image" priority=-1

        narration "It's been almost three years since I last performed at Antony's tavern." \
            "I remember being so nervous about getting up on stage, thinking that I was going in the wrong direction." \
            "'Are they going to laugh at me? Is the hammer costume too gimmicky? How do I know I'm not walking into failure?'"
        
        narration "Some part of me asked those questions again today, wondering if I made the right move then." \
            "Surely, I must have, I was fantastic." \
            "It was the most thrilling experience I've had in three years." \
            "'So, why am I still so uneasy about this? Maybe I'm just lonely...'"
        
        narration "I sigh and look out my apartment window, watching as the waves crash against the shore." \
            "There's nothing more intriguing and mystifying than to watch on the beach, especially this early in the morning." \
            "It puts my mind at ease, allowing me to forget this uneasy feeling and self-doubt. Well, probably that and dream therapy."

        narration "I pull out a plastic container from the fridge and microwave it." \
            "Carefully, I open the container and pull out a pancake." \
            "'Mmm, pancakes...'" \
            "I grab the top layer and take a bite, getting lost in its fluffiness." \
            "There's no way I can resist my favorite comfort food."

        narration "'Hmm, maybe I should spend some time in nature today...'" \
            "I've always wanted to explore the forest north of here. It would probably help me mull over everything." \
            "As soon as I finish my pancakes, I grab a water bottle and my purse, put my hammer helmet and shows on, and head out the door."

        refresh "ForestDay" kind="image" priority=-1
        narration "Within half an hour, I make my way into the forest." \
            "I keep walking for a while, not really keeping track of where I am." \
            "There's barely and wind this morning, and the forest is ever so quiet." \
            "It almost feels as if it's been abandoned for years." \
            "'What a disturbing yet comforting feeling.'"

        refresh "Remains" kind="image" priority=-1
        narration "Eventually, I find myself approaching some ruins." \
            "I can't tell how far I've walked, let alone where I am, exactly." \
            "The environment beckons to me, drawing me in closer." \
            "I haven't seen anything like this before; it's almost like an entirely different world." \
            "I turn to the side and look down, witnessing the entirety of New Rollinsport right undereath my paws." \
            "'Wow, I went *far*...'"
        
        narration "Carefully, I make my way into the center of the ruins, noticing a series of gray obelisks towering over me." \
            "The've been arranged into a ring, with one smaller obelisk in the center." \
            "Ominous hums echo throughout the ruins, like as if the obelisks were singing to each other in some language I don't understand."

        refresh "chels_2h" kind="image" priority=1
        refresh "obelisk" kind="image" priority=2
        narration "I step closer to one of the obelisks, examining the sides of it." \
            "A series of unrecognizable symbols covers each side, something all the obelisks share." \
            "Some of the symbols glow dimly, but not quite randomly." \
            "Archeology isn't my thing, but this is super weird..."
        
        refresh "obel_0" kind="image" priority=2
        narration "Suddenly, I feel something poking my back." \
            "'Eh?'" \
            "I turn around, wary of what I'm gonna find behind me." \
            "To my surprise, the smaller obelisk has moved from the center, just barely towering over me." \
            "A pair of glowing blue eyes stares at me inquisitively."

        narration "'What the hell...?!'"
        narration "I'm so confused by what's in front of me, I'm unable to move or think..."
    
        question "What am I supposed to do?" {
            choice "Wave passively." {
                narration "I wave sheepishly, hoping that whatever entity stands before me doesn't react poorly."
            }

            choice "Back away." {
                narration "I let out a small nervous laugh and slowly back away, hoping to gain some distance."
            }
        }

        narration "The eyes continue to watch me, almost puzzled."
        narration "What is this thing, and why is it watching me?"

        question "" {
            choice "Speak to the obelisk." {
                dialogue who="Chelsea" "Uhh... hi?"
                refresh "obel_0d" kind="image" priority=2
                narration "The obelisk's eyes dart away shyly."
                dialogue who="???" "S-sorry, I just, uh..."
                refresh "obel_0" kind="image" priority=2
                dialogue who="???" "I've heard the humans that come up here speak of hammers before."
                refresh "obel_0c" kind="image" priority=2
                dialogue who="???" "But I've never seen one up close before."
                narration "Before I know it, those inquisitive eyes look back at me with excitement."
                narration "I let out a nervous laugh."

                question "" {
                    choice "Entertain the obelisk." {
                        dialogue who="Chelsea" "Oh, well, we hammers tend to not walk too far from the toolbox."
                        dialogue who="???" "Toolbox?"
                        dialogue who="Chelsea" "Of course. Surprising how much space the humans give us alongside everyone else."
                        dialogue who="???" "You're not really a hammer, are you?"
                        dialogue who="Chelsea" "Sorry to disappoint."
                    }

                    choice "Explain it's a helmet." {
                        dialogue who="Chelsea" "I'm sorry to disappoint, but I'm not really a hammer."
                        dialogue who="Chelsea" "This is just a helmet."
                    }
                }

                dialogue who="Chelsea" "You see, I'm actually a coyote."
                narration "I yank the hammer helmet off my head."
                refresh "chels_2" kind="image" priority=1
                dialogue who="???" "How... intriguing. How do such big ears fit into such a small space?"
                dialogue who="Chelsea" "Snugly, actually. The helmet's made of rubber."
                
                narration "I put the helmet back on to demonstrate."
                
                refresh "chels_2h" kind="image" priority=1
                dialogue who="Chelsea" "See?"
                dialogue who="???" "I... see..."
                dialogue who="???" "Why do you hide behind such a facade?"
                dialogue who="Chelsea" "Brand recognition."
                dialogue who="???" "... brand recognition? What a strange term."
                dialogue who="Chelsea" "It's, uh, complicated..."
                dialogue who="???" "Well, I suppose that I'm a bit behind on the language."
                dialogue who="???" "It's not easy remembering all the changes."
            }

            choice "Back away more." {
                narration "I try to gain some more distance, but I back into an obelisk behind me."
                narration "Nervously, I step forward."
                narration "The obelisk doesn't budge."
                refresh "obel_0d" kind="image" priority=2
                dialogue who="???" "S-sorry, our presence can be... overbearing."
                refresh "obel_0" kind="image" priority=2
                dialogue who="???" "I can assure you that we mean no harm to your kind."
                dialogue who="???" "... or any kind, for that matter."
                dialogue who="???" "Many humans have travelled these ruins. But not a hammer."
                dialogue who="???" "I believe the expression to use here is 'that's a first'..."
                dialogue who="Chelsea" "... you can talk?"
                refresh "obel_0c" kind="image" priority=2
                dialogue who="???" "Yes, I am capable of speaking multiple languages."
                dialogue who="???" "Something that neither my brothers or sisters share."
                refresh "obel_0" kind="image" priority=2
                dialogue who="???" "Or, well, technically we do, but..."
                refresh "obel_0d" kind="image" priority=2
                dialogue who="???" "I'm the only one with a mouth, I suppose..."
                dialogue who="Chelsea" "O-Oh, okay..."
            }
        }

        
        refresh "obel_0" kind="image" priority=2
        dialogue who="Chelsea" "Oh, well, my name's Chelsea."
        dialogue who="???" "Chelsea..."
        narration "I stick out my hand, immediately forgetting the obelisk doesn't have any arms."
        dialogue who="Chelsea" "Oh, right, I forgot. Sorry, ehehe..."
        narration "The obelisk looks at me, confused by the gesture."
        dialogue who="Chelsea" "Uh, it was supposed to be a hand shake."
        dialogue who="???" "O-Oh."
        dialogue who="???" "Sorry, I... don't have any hands to shake."
        dialogue who="Chelsea" "Not to worry."
        dialogue who="Chelsea" "Um... do you have a name?"
        dialogue who="???" "A name?"
        dialogue who="???" "We... don't really have names. There is no such use for them."
        dialogue who="???" "Even if we did have such use, no one could ever speak them."
        
        refresh "obel_0d" kind="image" priority=2
        dialogue who="???" "In a way, it's a... miracle... I can even speak at all."
        dialogue who="Chelsea" "Oh, uh... how should I call you, then?"
        dialogue who="???" "I... don't know."
        dialogue who="Chelsea" "Okay, how about..."
        dialogue who="Chelsea" "... Obel?"
        
        refresh "obel_0" kind="image" priority=2
        dialogue who="???" "Obel..."
        dialogue who="???" "I..."
        refresh "obel_0c" kind="image" priority=2
        dialogue who="Obel" "I like that."
        dialogue who="Chelsea" "Obel it is. Nice to meet you, Obel."

        refresh "obel_0" kind="image" priority=2
        narration "The obelisk quickly scans around the area."
        dialogue who="Obel" "This might sound unusual, but..."
        dialogue who="Obel" "I... want to go on... oh, what do the humans call it?"
        refresh "obel_0c" kind="image" priority=2
        dialogue who="Obel" "Oh! An adventure!"
        refresh "obel_0" kind="image" priority=2
        dialogue who="Chelsea" "Adventure? To where?"
        dialogue who="Obel" "I've never really seen anywhere outside of here for hundreds of years."
        dialogue who="Obel" "A-and I know there has to be more than just the ring."
        dialogue who="Chelsea" "Okay. I think we can arrange that."
        dialogue who="Chelsea" "But how will you get around?"

        narration "Obel instantly hops around like an energetic rabbit."
        refresh "obel_0c" kind="image" priority=2
        dialogue who="Obel" "I have my methods."
        dialogue who="Chelsea" "O-kay then."
        narration "'How does an obelisk manage to do that?'"
        narration "I suppose it doesn't matter. Adventure time!"
    }
}

{
  "actions" : {
    "build" : {
      "postActions" : [
        {
          "script" : "#!\/bin\/sh\ncp .mbuild\/release\/libRollinsport.dylib Shounin\/bin\/mac\/",
          "type" : "runScript"
        }
      ]
    }
  },
  "extension" : {
    "identifier" : "net.marquiskurt.spm-tasks",
    "name" : "Swift Tasks"
  },
  "extensionTemplate" : "swiftBuild",
  "extensionValues" : {
    "package-config" : "release",
    "package-path" : "Rollinsport",
    "use-shared-settings" : false
  }
}
